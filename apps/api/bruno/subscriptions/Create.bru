meta {
  name: Create subscription
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/v1/subscriptions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bridgeToken}}
  Content-Type: application/json
}

body:json {
  {
    "platform": "discord",
    "userId": "42",
    "mint": "{{mint}}",
    "maxApy": 700
  }
}

assert {
  res.status: eq 201
}
